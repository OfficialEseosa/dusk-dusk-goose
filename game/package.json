{
  "name": "dusk-dusk-goose",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "assets": "node scripts/assets.mjs",
    "build": "tsc --noEmit -p tsconfig.client.json && tsc -p tsconfig.server.json && vite build",
    "start": "node dist/server/server/chase-server.js",
    "dev": "npm run build && npm start",
    "test": "tsx --test tests/server*.test.ts tests/chase*.test.ts",
    "test:e2e": "npm run build && playwright test",
    "test:chase": "tsx --test tests/chase*.test.ts",
    "balance": "tsx scripts/balance.ts"
  },
  "dependencies": {
    "three": "^0.186.1",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@fontsource/dm-sans": "^5.2.8",
    "@fontsource/fraunces": "^5.2.7",
    "@playwright/test": "^1.56.1",
    "@types/node": "^22.0.0",
    "@types/three": "^0.186.0",
    "@types/ws": "^8.18.1",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0"
  }
}
